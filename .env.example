# PostgreSQL connection URL. Create the database before running Alembic.
DATABASE_URL=postgresql+psycopg://shortlink:change-me@localhost:5432/shortlink

# Redis is used for redirect caching and the Redis Streams click queue.
REDIS_URL=redis://localhost:6379/0

# Used to construct public short links; never derived from the incoming Host header.
PUBLIC_BASE_URL=http://localhost:8000

# Frontend API URL (the frontend also has a local development fallback).
FRONTEND_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Administrative token for link deactivation. Set a long random value to enable the endpoint.
# Without a token, the deactivation endpoint is disabled.
ADMIN_API_TOKEN=

# Browser origins allowed to call the API. Comma-separated.
ALLOWED_FRONTEND_ORIGINS=http://localhost:5173

# Redirect cache, link creation throttling, and bounded Redis socket timeouts.
REDIRECT_CACHE_TTL_SECONDS=300
MAX_URL_LENGTH=2048
CREATE_RATE_LIMIT_COUNT=20
CREATE_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_SOCKET_TIMEOUT_SECONDS=0.5

# Redis Streams consumer settings.
CLICK_STREAM_NAME=shortlink:click-events
CLICK_CONSUMER_GROUP=shortlink-workers
CLICK_DEAD_LETTER_STREAM=shortlink:click-events:dead-letter
WORKER_CONSUMER_NAME=worker-1
WORKER_BATCH_SIZE=25
WORKER_BLOCK_MS=1000
WORKER_PENDING_IDLE_MS=30000
WORKER_MAX_DELIVERIES=5
WORKER_MAX_BACKOFF_SECONDS=300
LOG_LEVEL=INFO
